# Copy to .env for local runs. Never commit .env.
# On EC2 only BUCKET_NAME is read from Parameter Store (see deploy/bootstrap.sh).
# The Plaid values are needed only by the instructor, to regenerate the static data.

# Shared S3 bucket. Leave empty to use the local store in LOCAL_STORE_DIR.
BUCKET_NAME=
# Per-participant prefix. Must look like participants/<name>/
STORE_PREFIX=participants/demo/
LOCAL_STORE_DIR=./local_store

# Plaid sandbox credentials. The base URL is fixed to the sandbox host.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ACCESS_TOKEN=

# How long the dashboard caches data from S3, in seconds.
CACHE_SECONDS=60

# Dashboard bind address and port. Use 0.0.0.0 on EC2 and restrict the security group.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
